{
  "name": "worldnotes",
  "version": "0.1.0",
  "description": "Extensible inline-markdown editor with wiki-style navigation",
  "type": "module",
  "main": "./dist/worldnotes.umd.cjs",
  "module": "./dist/worldnotes.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/worldnotes.js",
      "require": "./dist/worldnotes.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev:server": "npx tsx src/server/index.ts",
    "dev:server:watch": "npx tsx watch src/server/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "markdown-it": "^15.0.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
