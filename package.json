{
  "name": "worldnotes",
  "version": "0.1.0",
  "description": "Self-hosted markdown wiki: OIDC-gated editing, cached server-rendered reading",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite build --config vite.client.config.ts --watch",
    "build": "npm run typecheck && vite build --config vite.client.config.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "tsx": "^4.20.6",
    "zod": "^4.6.5"
  }
}
