# ── WorldNotes server configuration ──────────────────────────────────────────
# Copy to .env and adjust. All variables are read by src/server/config.ts.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:change-me@localhost:5432/worldnotes

# ── OIDC (any spec-compliant provider: Keycloak, Authentik, Zitadel, ...) ────
# Discovery happens at <issuer>/.well-known/openid-configuration
OIDC_ISSUER=https://identity.example.com/realms/worldnotes
OIDC_CLIENT_ID=worldnotes
OIDC_CLIENT_SECRET=***
# Must be registered at the provider; served by this app:
OIDC_REDIRECT_URL=https://notes.example.com/oidc/callback

# Comma-separated AES keys for session-cookie encryption (each >= 32 chars).
# Multiple values enable rotation: new cookies use the first key, older
# cookies still validate against any listed key.
SESSION_SECRETS=replac…e-me
SESSION_MAX_AGE_SECONDS=28800

# Tolerance (seconds, 0-120) for id_token timestamp validation — raise if the
# app host and provider disagree by more than ~30s (NTP drift).
OIDC_CLOCK_TOLERANCE_SECONDS=30

# Server request logging: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# ── Read-path render cache (single process) ──────────────────────────────────
CACHE_MAX_ENTRIES=200
CACHE_TTL_SECONDS=55

# ── Editor client autosave debounce ──────────────────────────────────────────
AUTOSAVE_DEBOUNCE_MS=1500

# ── Uploaded media (favicon overrides; future editor images) ─────────────────
# Max bytes accepted by POST /api/media — the only effective ceiling for
# multipart uploads (Fastify's JSON bodyLimit does not apply). 2 MiB fits
# icons; raise for photographic content later.
MEDIA_MAX_BYTES=2097152

# ── Development only: bypass OIDC with a fake editor (refused in production) ─
# AUTH_DISABLED=1

# ── Roles (viewer | editor | admin; see docs/api.md) ──────────────────────
# Role granted to accounts provisioned AFTER the first-ever login (the first
# user to log in always becomes admin). 'admin' is deliberately not settable:
# admin comes from the bootstrap below, the empty-table rule, or a promotion.
# Set to 'viewer' to make every new account read-only until an admin promotes
# it — NOTE: with DEFAULT_ROLE=viewer, accounts that could edit before an
# upgrade silently become read-only on their next request.
# DEFAULT_ROLE=editor

# Comma-separated OIDC subs that ALWAYS provision as admin. Use this when
# upgrading an instance that already has live sessions: without it, whichever
# account's next request wins the empty-table bootstrap becomes admin (the
# grant is logged at warn either way — check the deploy log).
# BOOTSTRAP_ADMIN_SUBS=sub-from-idp-1,sub-from-idp-2

# ── Compose: DB password when using docker-compose.yml ───────────────────────
# DB_PASSWORD=***
